[Unit]
Description=Cecilia organ recorder and player
Documentation=https://github.com/cecilia-organ/cecilia
After=network-online.target sound.target
Wants=network-online.target

[Service]
User=cecilia
Group=cecilia
SupplementaryGroups=audio
EnvironmentFile=-/etc/default/cecilia
Environment=CECILIA_DATA_DIR=/var/lib/cecilia
Environment=CECILIA_WEB_DIR=/usr/share/cecilia/web
ExecStart=/usr/bin/cecilia
Restart=always
RestartSec=2
# MIDI timing: a little priority helps on a busy Pi.
Nice=-5
# Keep logs in the journal (RAM), not on the SD card.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
