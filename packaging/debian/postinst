#!/bin/sh
set -e
if [ "$1" = "configure" ]; then
    if ! getent passwd cecilia >/dev/null; then
        adduser --system --group --home /var/lib/cecilia --no-create-home cecilia
    fi
    # MIDI (ALSA sequencer and USB MIDI) and the sound card.
    adduser cecilia audio >/dev/null 2>&1 || true
    # Load the ALSA sequencer now (and at every boot, via modules-load.d).
    modprobe snd-seq 2>/dev/null || true
    mkdir -p /var/lib/cecilia
    chown cecilia:cecilia /var/lib/cecilia
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload
        systemctl enable cecilia.service >/dev/null
        systemctl restart cecilia.service
    fi
fi
exit 0
